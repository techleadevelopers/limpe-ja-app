# Aprenda mais: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Arquivos sensíveis / Segredos (NUNCA commitar!)
*.jks
*.keystore
*.key
*.p8
*.p12
*.pem
*.mobileprovision
google-services.json
gcs-key.json
limpeja-run-sa-key*.json

# APKs, IPAs, AABs
*.apk
*.ipa
*.aab

# Dependências
node_modules/
yarn-error.log
npm-debug.log*
yarn-debug.log*
functions/node_modules/

# Saídas de Build / Caches (Expo / Metro / TypeScript / CI)
.expo/
dist/
web-build/
.metro-health-check*
functions/lib/
*.tsbuildinfo
coverage/
lcov.info
*.tar.gz

# Android
android/app/build/
android/.gradle/
android/sentry.properties

# iOS
ios/build/
ios/Pods/

# Outros nativos
.kotlin/
*.orig

# Arquivos de Ambiente (somente exemplos ficam no git)
.env
.env.*
!.env.example
.env.local

# Firebase CLI e Emuladores
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
storage-debug.log
*.emulators.export
emulators-data/

# Arquivos de Editor / SO
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db

# Logs diversos
*.log
*.log.*
logs/

# Jest cache
.jest-cache

# Yarn PnP
.pnp.*
.yarn/*

# Arquivos do Expo
expo-env.d.ts
