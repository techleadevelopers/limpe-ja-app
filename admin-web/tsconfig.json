{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@react-leaflet/core": ["./client/src/lib/react-leaflet-core-patched.ts"],
      "@react-leaflet/core/lib/*": ["./node_modules/@react-leaflet/core/lib/*"],
      "@react-leaflet/core/lib/index": ["./node_modules/@react-leaflet/core/lib/index"],
      "@react-leaflet/core/lib/index.js": ["./node_modules/@react-leaflet/core/lib/index.js"]
    }
  }
}
