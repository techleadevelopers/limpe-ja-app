{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug Android (Expo)",
            "request": "launch",
            "type": "reactnative",
            "platform": "android",
            "cwd": "${workspaceFolder}"
            // Para "launch", a extensão React Native Tools geralmente lida com host e porta automaticamente.
            // Se ainda pedir o IP, você pode tentar adicionar:
            // "debuggerHost": "192.168.93.26",
            // "port": 8081
            // Mas tente sem eles primeiro para ver se funciona.
        },
        {
            "name": "Debug in Expo Go (dispositivo/emulador)",
            "request": "launch",
            "type": "reactnative",
            "platform": "exponent", // Este é para Expo Go, seja em emulador ou dispositivo físico
            "cwd": "${workspaceFolder}",
            // Para "launch" com "exponent", a extensão também tenta ser inteligente.
            // Se ainda pedir o IP, você pode tentar adicionar:
            // "debuggerHost": "192.168.93.26",
            // Mas tente sem eles primeiro.
        },
        {
            "name": "Attach to Metro Bundler", // Esta é a sua configuração mais confiável para depuração JS
            "request": "attach",
            "type": "reactnative",
            "cwd": "${workspaceFolder}",
            "port": 8081, // Porta padrão do Metro Bundler
        }
    ]
}