{
  "displayName": "unit",
  "preset": "ts-jest",
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/unit/**/*.spec.ts",
    "<rootDir>/src/**/*.spec.ts"
  ],
  "moduleFileExtensions": ["ts", "tsx", "js", "json"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json",
        "diagnostics": false
      }
    ]
  }
}
