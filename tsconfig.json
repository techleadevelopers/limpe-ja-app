{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // MUITO IMPORTANTE: base para a resolução de módulos
    "baseUrl": ".",

    // Aliases (alinhados com o babel.config.js)
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["./app/*"],
      "@types/*": ["./types/*"],
      "@assets/*": ["assets/*"],
      "@3d/*": ["assets/images/3d/*"],
      "@constants/*": ["./constants/*"],
      "@components/*": ["./components/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "build",
    "dist"
  ]
}
