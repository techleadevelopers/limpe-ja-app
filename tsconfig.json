{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Segurança
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // ESM/CJS
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    // RN + Web (TS 5+)
    "module": "esnext",
    "moduleResolution": "bundler",

    // Alvos modernos
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",

    // QoL
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    // Base/aliases
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["./app/*"],
      "@types/*": ["./types/*"],
      "@assets/*": ["assets/*"],
      "@3d/*": ["assets/images/3d/*"],
      "@constants/*": ["./constants/*"],
      "@components/*": ["./components/*"]
    },

    // Dicas de tipos por ambiente
    "types": ["react", "react-native", "expo", "expo-router", "jest"]
  },

  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "types/**/*.ts",
    "services/**/*.ts",
    "services/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "index.ts",
    "index.tsx",
    "global.d.ts"
, "styles/providerStyles.ts", "data/mockData.ts", "utils/platformFix.ts", "utils/paymentIntentHooks.ts", "__tests__/notificationsPipeline.test.tsx", "__tests__/booking/schedule-service.insurance.test.tsx", "__tests__/booking/BookingSuccessScreen.test.tsx", "__tests__/booking/BookingDetailsScreen.test.tsx", "__tests__/safety/incident-report.test.tsx", "__tests__/auth/reset-password.confirm.test.tsx", "__tests__/auth/forgot-password.flow.test.tsx", "utils/locationFilter.ts"  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "build",

    // mantém fora para não confundir o TS do app
    "admin-web/**",
    "backend-cleaning/**",

    // tooling/ci se existir
    "e2e",

    // backups/rascunhos
    "**/*.backup.ts",
    "**/*.backup.tsx"
  ]
}
