{
  "name": "relax-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build": "eas build",
    "check-key": "node run-check.js",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:test:ios": "detox test --configuration ios.sim.debug",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:test:android": "detox test --configuration android.emu.debug",
    "eas-build-post-install": "node -e \"console.log('skip postinstall'); process.exit(0)\"",
    "schema": "backend-cleaning/prisma/schema.prisma"
  },
  "overrides": {
    "react-native-safe-area-context": "5.6.0",
    "react-native-calendars": {
      "react-native-safe-area-context": "5.6.0"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "^5.84.1",
    "@types/google-cloud__storage": "^1.7.2",
    "axios": "^1.9.0",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "expo": "54.0.13",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~1.0.9",
    "expo-calendar": "~15.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.15",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.8",
    "expo-gl": "~16.0.7",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "~17.0.7",
    "expo-localization": "~17.0.7",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.12",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "firebase": "^11.8.1",
    "i18next": "^25.4.0",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.1",
    "react-native": "0.81.4",
    "react-native-calendars": "^1.1312.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.1",
    "twilio": "^5.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@prisma/client": "^5.13.0",
    "@types/bcrypt": "^5.0.2",
    "@types/detox": "^18.1.3",
    "@types/jwt-decode": "^2.2.1",
    "@types/node": "^22.15.30",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "bcrypt": "^6.0.0",
    "detox": "^20.41.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-build-properties": "^1.0.9",
    "firebase-tools": "^14.5.1",
    "prisma": "^5.13.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "newArchEnabled": false
          }
        }
      ]
    ],
    "install": {
      "exclude": [
        "@shopify/react-native-skia",
        "react-native-reanimated",
        "react-native-gesture-handler",
        "react-native",
        "react-native-vision-camera"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "react-native-skeleton-placeholder",
          "jwt-decode"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
